MP_API_KEY=YOUR_KEY_HERE
MP_API_TOKEN=YOUR_TOKEN_HERE
SDK_KEY=XXX
SDK_DOMAINS=localhost
VEXCEL_API_KEY=XXX
# Select Gemini in the workbench to use hosted mission planning (requires pip install -e '.[agent]').
# The API key stays on the server. Campaign experiments have separate approval requirements.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Configure only AFTER the user's explicit approve; never point this at an unreviewed file.
# RESCUETWIN_APPROVED_CAMPAIGN=data/experiments/approved-campaign.json
# CPU detector threads; bounded to avoid starving rendering/simulation.
RESCUETWIN_VISION_THREADS=2
# Local recording storage (ignored by Git).
RESCUETWIN_RUNS=data/runs

# One-command bringup (./setup.sh). Exported variables override this file.
RESCUETWIN_MODEL_ID=XXXXXXX
RESCUETWIN_BACKEND_PORT=8000
RESCUETWIN_FRONTEND_PORT=5173
# Optional local YOLO weights; default: data/weights/yolo26n.pt
# YOLO_WEIGHTS=/absolute/path/to/yolo26n.pt
# Canonical Matterport credentials (MP_* aliases above remain supported):
# MATTERPORT_API_KEY=
# MATTERPORT_API_TOKEN=
# Optional: pinned Blender 5.2.2 for reproducing missing human GLBs; cached assets need no Blender.
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
