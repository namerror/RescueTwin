# Private sponsor scene selection; obtain the ID from your authorized scene manifest.
# Import can use the manifest default; set this for subsequent ./setup.sh launches.
RESCUETWIN_MODEL_ID=
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Legacy MP_API_KEY / MP_API_TOKEN aliases are also accepted.

# Optional interactive Gemini planning; credentials stay server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tool-backed experiments require a separately and explicitly approved local campaign.
# RESCUETWIN_APPROVED_CAMPAIGN=data/experiments/approved-campaign.json

RESCUETWIN_BACKEND_PORT=8000
RESCUETWIN_FRONTEND_PORT=5173
RESCUETWIN_VISION_THREADS=2
RESCUETWIN_RUNS=data/runs
# YOLO_WEIGHTS=/absolute/path/to/local-model.pt
# RESCUETWIN_RUN_SPEED=2
# Optional Blender executable for reproducing missing human meshes.
# BLENDER_BIN=/absolute/path/to/blender
