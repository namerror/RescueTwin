MP_API_KEY=YOUR_KEY_HERE
MP_API_TOKEN=YOUR_TOKEN_HERE
SDK_KEY=XXX
SDK_DOMAINS=localhost
VEXCEL_API_KEY=XXX
# Optional hosted reasoning (export into the server environment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order when GEMINI_MODEL is overloaded (503), out of quota (429) or slower than the budget.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: seconds allowed per model before trying the next one (Gemini itself requires a >=10 s server deadline).
GEMINI_MODEL_BUDGET_S=3
